# URL do projeto Supabase (Settings > API / Connect)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Publishable key: sb_publishable_... (ou anon legado)
SUPABASE_PUBLISHABLE_KEY=SUBSTITUA_PELA_CHAVE_PUBLICAVEL
# Secret key: sb_secret_... (ou service_role legado). SOMENTE SERVIDOR!
SUPABASE_SECRET_KEY=SUBSTITUA_PELA_CHAVE_SECRETA
# E-mail exato de um usuário confirmado, criado manualmente no Supabase Auth
ADMIN_EMAIL=admin@exemplo.com
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=SUBSTITUA_POR_64_CARACTERES_HEXADECIMAIS
# Segredo INDEPENDENTE, gerado com o mesmo comando. Mantenha estável e faça backup:
# sua troca invalida os códigos numéricos (não há código em texto para recuperá-los).
CODE_LOOKUP_SECRET=SUBSTITUA_POR_OUTROS_64_CARACTERES_HEXADECIMAIS
# Origem exata, sem / final. No deploy, use https://seu-projeto.vercel.app
APP_URL=http://localhost:3000
